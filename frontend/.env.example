# Copy this file to .env(.local) and adjust for your local setup.
# Vite only exposes variables prefixed with VITE_ to client code, and
# bakes them into the built JavaScript — never put a secret in one.

# Base URL of the NOSTRA Django backend (scheme + host, no path).
# Local development: defaults to http://localhost:8000 if unset.
# PRODUCTION BUILD: set it to the deployed backend's HTTPS origin, e.g.
# https://api.example.com, in the build environment. If left unset, the
# built app calls the API on its own origin (frontend and backend served
# from the same domain).
VITE_API_BASE_URL=http://localhost:8000
