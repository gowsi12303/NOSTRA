# Copy this file to .env and fill in real values for your local setup.
# .env is gitignored and must never be committed.

# Django's cryptographic signing key. Generate your own, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Optional: comma-separated list of extra frontend origins allowed to make
# cross-origin requests to this API. If unset, defaults to the common local
# dev server origins (CRA :3000, Vite :5173) — see config/settings.py.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
