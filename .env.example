# Copy this file to .env and fill in real values for your local setup.
# .env is gitignored and must never be committed.
#
# The uncommented values below are safe for LOCAL DEVELOPMENT only.
# Each section notes what must change in production.

# Django's cryptographic signing key. Generate your own, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# PRODUCTION: required, must be a fresh value used nowhere else.
SECRET_KEY=

# Debug mode. Defaults to False if unset, so local development needs
# this line.
# PRODUCTION: must be False (or omitted).
DEBUG=True

# Comma-separated hostnames this backend may serve. May stay empty while
# DEBUG=True (localhost / 127.0.0.1 are then accepted automatically).
# PRODUCTION: required, e.g. ALLOWED_HOSTS=api.example.com
# (On Render the service's own onrender.com host is added automatically
# from RENDER_EXTERNAL_HOSTNAME; list only custom domains here.)
ALLOWED_HOSTS=

# Optional: comma-separated list of frontend origins allowed to make
# cross-origin requests to this API. If unset, defaults to the common local
# dev server origins (CRA :3000, Vite :5173) — see config/settings.py.
# PRODUCTION: set to the deployed frontend origin(s), e.g. https://www.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated origins (including scheme, no path) trusted for
# CSRF-protected requests, i.e. the Django admin login. Not needed locally.
# PRODUCTION: add the deployed HTTPS origins of both the backend and the
# frontend, e.g.
#   CSRF_TRUSTED_ORIGINS=https://api.example.com,https://www.example.com
# CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------
# Leave DATABASE_URL unset locally: the backend then uses the SQLite file
# db.sqlite3 in the project root, with no database server to install.
# PRODUCTION: required, a PostgreSQL URL supplied by the host, in the form
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# (URL-encode any special characters in the password.)
# DATABASE_URL=postgres://nostra_user:change-me@localhost:5432/nostra

# Seconds a database connection is kept open and reused across requests.
# Defaults to 0 (close after each request) — leave unset for SQLite.
# PRODUCTION: 60 is a reasonable starting point with PostgreSQL. Keep it
# at 0 if a connection pooler in transaction mode sits in front of the
# database.
# CONN_MAX_AGE=60

# Verify a reused connection is still alive before a request uses it, and
# reconnect if not. Defaults to True; only matters when CONN_MAX_AGE is
# above 0, and costs one trivial query per request.
# PRODUCTION: leave True.
# CONN_HEALTH_CHECKS=True

# After the first deploy against a new database, create its tables with:
#   python manage.py migrate

# --- API (Django REST Framework) ------------------------------------
# Serve DRF's browsable HTML API alongside JSON. Defaults to the value of
# DEBUG, so it is on locally and off in production with no entry needed.
# PRODUCTION: leave unset or False (JSON only).
# DRF_BROWSABLE_API=False

# Rate limits, as "<count>/<second|minute|hour|day>". The values shown
# are the built-in defaults — set a variable only to tune it.
#   ANON      all requests from one unauthenticated client IP
#   USER      all requests from one signed-in account
#   LOGIN     POST /api/accounts/login/    (per client IP)
#   REGISTER  POST /api/accounts/register/ (per client IP)
# Limits are disabled automatically while running `manage.py test`.
# THROTTLE_RATE_ANON=100/minute
# THROTTLE_RATE_USER=300/minute
# THROTTLE_RATE_LOGIN=10/minute
# THROTTLE_RATE_REGISTER=10/hour

# Number of trusted reverse proxies in front of the app, so per-IP limits
# see the real client address from X-Forwarded-For instead of the proxy's.
# Leave unset locally.
# PRODUCTION: set to the proxy count of your host (usually 1).
# NUM_PROXIES=1

# --- JWT authentication ---------------------------------------------
# The values shown are the built-in defaults, suitable for production —
# set a variable only to change it.

# How long an access token is valid, in minutes. Keep it short: an access
# token cannot be revoked and stays usable until it expires, even after
# logout.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# How long a refresh token is valid, in days — i.e. how long a user can
# stay signed in without entering their password again.
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Issue a new refresh token on every refresh, and blacklist the one just
# used so it cannot be replayed. Clients must store the new refresh token
# from each /token/refresh/ response.
# PRODUCTION: keep both True.
# JWT_ROTATE_REFRESH_TOKENS=True
# JWT_BLACKLIST_AFTER_ROTATION=True

# Record the user's last_login on every login. Off by default because it
# adds a database write to each token issue.
# JWT_UPDATE_LAST_LOGIN=False

# Accepted Authorization header scheme(s), comma-separated. The frontend
# sends "Authorization: Bearer <token>" — do not change without it.
# JWT_AUTH_HEADER_TYPES=Bearer

# --- Logging --------------------------------------------------------
# Threshold for the Django and application loggers; everything is written
# to the console (stderr). One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Defaults to INFO (ERROR while running `manage.py test`).
# PRODUCTION: INFO or WARNING. Do not run production at DEBUG — it logs
# every SQL query, including the values in it.
# LOG_LEVEL=INFO

# --- Email ----------------------------------------------------------
# Leave all of these unset locally: mail is then printed to the console
# instead of being sent.
# PRODUCTION: switch to SMTP and fill in your mail provider's details.
# Never commit real credentials — they belong only in the real .env /
# the host's secret store.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Use STARTTLS (port 587, the default) or implicit SSL (port 465) — set
# at most one of the two to True.
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Seconds before an SMTP connection attempt gives up.
# EMAIL_TIMEOUT=10

# From-address for ordinary mail, and for error-report mail to ADMINS.
# DEFAULT_FROM_EMAIL=NOSTRA <no-reply@example.com>
# SERVER_EMAIL=errors@example.com

# Comma-separated addresses emailed whenever an ERROR is logged (an
# unhandled exception / HTTP 500) while DEBUG is False. Optional — when
# unset, errors are only written to the log.
# ADMINS=ops@example.com,dev@example.com

# --- Media (uploaded product images) --------------------------------
# Leave all of these unset locally: uploads are then written to the
# project's media/ directory (gitignored) and served by Django itself
# while DEBUG=True.
#
# PRODUCTION: uploads must live somewhere that survives a redeploy, and
# Django does NOT serve them when DEBUG=False. No hosting provider has
# been chosen yet, so nothing provider-specific is configured — pick ONE
# of the two approaches below when one is.
#
# (a) Persistent disk. Keep the default filesystem backend, point
#     MEDIA_ROOT at a persistent volume, and have the web server / proxy
#     serve that directory at MEDIA_URL.
# MEDIA_ROOT=/var/lib/nostra/media
# MEDIA_URL=media/
#
# (b) S3-compatible object storage (what the Render deployment uses, since
#     a Render service's disk is wiped on every deploy). Works with any
#     S3-compatible provider; none is chosen yet. Select the backend and
#     fill in the bucket details. Placeholders only — real credentials
#     belong in the host's secret store, never in this file.
# MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Endpoint of a non-AWS provider (omit for AWS itself), and the region if
# the provider requires one.
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION_NAME=
# True (default): image URLs are time-limited signed links, so the bucket
# can stay private. False: plain links, which need a publicly readable
# bucket or S3_CUSTOM_DOMAIN (a public/CDN host for the bucket, no scheme).
# S3_QUERYSTRING_AUTH=True
# S3_CUSTOM_DOMAIN=media.example.com
#
# Any other storage class can be used instead by naming it here and
# passing its keyword arguments as a JSON object.
# MEDIA_STORAGE_OPTIONS={"option_name": "value"}

# Largest product image, in MB, accepted by the admin upload form.
# PRODUCT_IMAGE_MAX_UPLOAD_MB=5

# --- Static files / app server --------------------------------------
# No variables needed. Locally, `runserver` serves static files itself.
# PRODUCTION: run `python manage.py collectstatic --noinput` on each
# deploy (output goes to staticfiles/, served by WhiteNoise) and start
# the app with Gunicorn (Linux/macOS only):
#   gunicorn config.wsgi:application

# --- HTTPS / transport security -------------------------------------
# Leave all of these unset locally. PRODUCTION values are shown.
# A typical production setup behind an HTTPS reverse proxy enables
# SECURE_SSL_REDIRECT, SECURE_HSTS_SECONDS and USE_PROXY_SSL_HEADER;
# the secure cookies then follow from DEBUG=False.

# Redirect every HTTP request to HTTPS. Never enable locally or for the
# test suite (requests would all become 301s). Behind a proxy, enable
# USE_PROXY_SSL_HEADER as well or the redirect loops.
# SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security max-age, in seconds. Off (0) unless set
# here — it is never hardcoded, because browsers remember the policy for
# the whole max-age and it cannot be withdrawn. Start small (e.g. 3600)
# and raise to 31536000 once HTTPS is confirmed working.
# SECURE_HSTS_SECONDS=3600

# Extend HSTS to every subdomain / allow submission to the browser
# preload list. Both default to False and should stay off unless every
# subdomain is HTTPS-only for good; preload in particular is very slow
# to reverse. They have no effect while SECURE_HSTS_SECONDS is unset.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Send session / CSRF cookies over HTTPS only. Both default to True
# whenever DEBUG is False, so they normally need no entry at all; set to
# False only to run DEBUG=False over plain HTTP.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Trust the X-Forwarded-Proto header to detect HTTPS. Enable ONLY when
# the app runs behind a reverse proxy / load balancer that sets this
# header itself (most hosting platforms do).
# USE_PROXY_SSL_HEADER=True
